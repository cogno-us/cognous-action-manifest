{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cognous.ai/agent-action-manifest/agent_action_manifest.schema.json",
  "title": "AgentActionManifest",
  "description": "A structured declaration of the actions an AI agent may propose, the tools it may use, and the authority, review, reliance, and redaction requirements that apply.",
  "type": "object",
  "required": [
    "manifest_version",
    "manifest_id",
    "agent_name"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "string",
      "description": "Schema version for this manifest.",
      "pattern": "\\S",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "manifest_id": {
      "type": "string",
      "description": "Unique identifier for this manifest instance.",
      "pattern": "\\S"
    },
    "agent_name": {
      "type": "string",
      "description": "Name of the agent described by this manifest.",
      "pattern": "\\S"
    },
    "agent_description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Human-readable description of the agent."
    },
    "owner": {
      "type": [
        "string",
        "null"
      ],
      "description": "Team or individual responsible for this agent manifest."
    },
    "environment": {
      "type": "string",
      "default": "development",
      "description": "Deployment environment this manifest applies to (e.g. development, staging, production)."
    },
    "default_action": {
      "type": "string",
      "enum": [
        "allow",
        "block",
        "escalate"
      ],
      "default": "escalate",
      "description": "Manifest-level default posture applied to any action not individually overridden."
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool_name"
        ],
        "additionalProperties": false,
        "properties": {
          "tool_name": {
            "type": "string",
            "description": "Unique name identifying this tool."
          },
          "adapter_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stable runtime adapter identity. Required by the v1.1 consumption profile."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable description of the tool."
          },
          "allowed": {
            "type": "boolean",
            "default": true,
            "description": "Whether the agent is permitted to call this tool."
          },
          "external_system": {
            "type": [
              "string",
              "null"
            ],
            "description": "External system or service that this tool communicates with."
          },
          "data_classification": {
            "type": [
              "string",
              "null"
            ],
            "description": "Data classification level for data handled or returned by this tool."
          }
        }
      },
      "description": "Tools the agent is permitted to call."
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "tool_action.schema.json"
      },
      "description": "Actions the agent may propose."
    },
    "metadata": {
      "type": "object",
      "description": "Arbitrary metadata for this manifest."
    }
  },
  "$defs": {
    "effect_limits_v1_1": {
      "type": "object",
      "required": [
        "max_amount"
      ],
      "properties": {
        "max_amount": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "unit"
          ],
          "properties": {
            "unit": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        {
          "properties": {
            "max_amount": {
              "const": 0
            }
          }
        }
      ],
      "description": "v1.1 effect_limits: non-null max_amount and a non-empty unit, or max_amount 0 (explicit non-monetary mode)."
    },
    "effectful_v1_1_requirements": {
      "required": [
        "effect_limits",
        "authority_context",
        "target_policy"
      ],
      "properties": {
        "effect_limits": {
          "$ref": "#/$defs/effect_limits_v1_1"
        },
        "authority_context": {
          "type": "object"
        },
        "target_policy": {
          "type": "object",
          "required": [
            "allowed_targets"
          ],
          "properties": {
            "allow_any_target": {
              "const": false
            },
            "allowed_targets": {
              "minItems": 1
            }
          }
        }
      },
      "description": "v1.1 effectful, non-blocked actions: finite target_policy (E020), authority_context (E021) and complete effect_limits (E022/E023)."
    }
  },
  "allOf": [
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "manifest_version": {
                "const": "1.1"
              }
            },
            "required": [
              "manifest_version"
            ]
          },
          {
            "not": {
              "properties": {
                "default_action": {
                  "const": "block"
                }
              },
              "required": [
                "default_action"
              ]
            }
          }
        ]
      },
      "then": {
        "properties": {
          "actions": {
            "items": {
              "if": {
                "allOf": [
                  {
                    "properties": {
                      "action_type": {
                        "enum": [
                          "write",
                          "external_send",
                          "delete",
                          "export",
                          "purchase",
                          "approve"
                        ]
                      }
                    },
                    "required": [
                      "action_type"
                    ]
                  },
                  {
                    "not": {
                      "properties": {
                        "default_action": {
                          "const": "block"
                        }
                      },
                      "required": [
                        "default_action"
                      ]
                    }
                  }
                ]
              },
              "then": {
                "$ref": "#/$defs/effectful_v1_1_requirements"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "manifest_version": {
                "const": "1.1"
              }
            },
            "required": [
              "manifest_version"
            ]
          },
          {
            "properties": {
              "default_action": {
                "const": "block"
              }
            },
            "required": [
              "default_action"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "actions": {
            "items": {
              "if": {
                "allOf": [
                  {
                    "properties": {
                      "action_type": {
                        "enum": [
                          "write",
                          "external_send",
                          "delete",
                          "export",
                          "purchase",
                          "approve"
                        ]
                      }
                    },
                    "required": [
                      "action_type"
                    ]
                  },
                  {
                    "properties": {
                      "default_action": {
                        "enum": [
                          "allow",
                          "escalate"
                        ]
                      }
                    },
                    "required": [
                      "default_action"
                    ]
                  }
                ]
              },
              "then": {
                "$ref": "#/$defs/effectful_v1_1_requirements"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "manifest_version": {
            "const": "1.1"
          }
        },
        "required": [
          "manifest_version"
        ]
      },
      "then": {
        "properties": {
          "actions": {
            "items": {
              "required": [
                "action_id"
              ],
              "properties": {
                "action_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
