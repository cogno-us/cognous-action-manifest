{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cognous.ai/agent-action-manifest/runtime_action_proposal_v1_2.schema.json",
  "title": "RuntimeActionProposalV12",
  "description": "Tenant-aware runtime-action-proposal/1.2 exact proposal material. Schema validity is not authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "manifest_id",
    "manifest_version",
    "manifest_digest",
    "actor",
    "principal",
    "action_id",
    "adapter_id",
    "target",
    "payload",
    "payload_commitment"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Trusted tenant scope. Exact opaque value; no inference or normalization."
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_version": {
      "const": "1.1"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "principal": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "payload_commitment": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requested_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "unit": {
      "type": "string",
      "default": ""
    },
    "effects": {
      "type": "integer",
      "minimum": 0,
      "default": 1
    },
    "authority_context_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "requirement_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "risk_metadata": {
      "type": "object",
      "default": {}
    },
    "not_before": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_side_effects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
